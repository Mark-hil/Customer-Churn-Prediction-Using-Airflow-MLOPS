  "links": [],
  "liveNow": true,

  "panels": [
    {
      "datasource": null,
      "description": "Distribution of requests between test groups",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 80,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 1,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 10,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "sum by (model_type) (increase(ab_test_predictions_total{status=\"total\"}[$__interval]))",
          "refId": "A",
          "legendFormat": "{{model_type}}",
          "interval": "1m"
        }
      ],
      "title": "Request Distribution by Group",
      "type": "timeseries"
    },
    {
      "datasource": null,
      "description": "Average prediction time by model type",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "axisCenteredZero": false,
            "axisColorMode": "text",
            "axisLabel": "ms",
            "axisPlacement": "auto",
            "barAlignment": 0,
            "drawStyle": "line",
            "fillOpacity": 10,
            "gradientMode": "none",
            "hideFrom": {
              "legend": false,
              "tooltip": false,
              "viz": false
            },
            "lineInterpolation": "linear",
            "lineWidth": 2,
            "pointSize": 5,
            "scaleDistribution": {
              "type": "linear"
            },
            "showPoints": "auto",
            "spanNulls": false,
            "stacking": {
              "group": "A",
              "mode": "none"
            },
            "thresholdsStyle": {
              "mode": "off"
            }
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 11,
      "options": {
        "legend": {
          "calcs": [
            "mean",
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "right",
          "showLegend": true
        },
        "tooltip": {
          "mode": "single",
          "sort": "none"
        }
      },
      "targets": [
        {
          "expr": "rate(ab_test_prediction_time_seconds_sum{model_type=\"production\"}[5m]) / rate(ab_test_prediction_time_seconds_count{model_type=\"production\"}[5m]) * 1000",
          "refId": "A",
          "legendFormat": "Production",
          "interval": "1m"
        },
        {
          "expr": "rate(ab_test_prediction_time_seconds_sum{model_type=\"shadow\"}[5m]) / rate(ab_test_prediction_time_seconds_count{model_type=\"shadow\"}[5m]) * 1000",
          "refId": "B",
          "legendFormat": "Shadow",
          "interval": "1m"
        }
      ],
      "title": "Average Prediction Time (ms)",
      "type": "timeseries"
    },
    {
      "datasource": null,
      "description": "Statistical significance of accuracy difference between groups (p-value)",
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [
            {
              "options": {
                "0.05": {
                  "color": "red",
                  "index": 0,
                  "text": "Significant"
                },
                "1": {
                  "color": "green",
                  "index": 1,
                  "text": "Not Significant"
                }
              },
              "type": "value"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 0.05
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 6,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "id": 12,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.1.6",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(ab_test_accuracy_p_value_bucket[5m])) by (le))",
          "refId": "A",
          "legendFormat": "p-value",
          "interval": "1m"
        }
      ],
      "title": "Statistical Significance (p-value) - Lower is Better",
      "type": "stat"
    },
    {
      "datasource": null,
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "thresholds"
          },
          "mappings": [],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#EAB839",
                "value": 0.7
              },
              {
                "color": "green",
                "value": 0.8
              }
            ]
          },
          "unit": "percentunit"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "id": 2,
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "auto"
      },
      "pluginVersion": "9.1.6",
      "targets": [
        {
          "expr": "sum(increase(ab_test_predictions_total{model_type=\"production\", status=\"correct\"}[$__range])) / sum(increase(ab_test_predictions_total{model_type=\"production\", status=\"total\"}[$__range]))",
          "refId": "A",
          "legendFormat": "Production ({{model_type}})",
          "interval": "1m"
        },
        {
          "expr": "sum(increase(ab_test_predictions_total{model_type=\"shadow\", status=\"correct\"}[$__range])) / sum(increase(ab_test_predictions_total{model_type=\"shadow\", status=\"total\"}[$__range]))",
          "refId": "B",
          "legendFormat": "Shadow ({{model_type}})",
          "interval": "1m"
        }
      ],
      "title": "Model Accuracy",
      "type": "stat"
    },
